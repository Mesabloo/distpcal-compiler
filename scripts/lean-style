#!/usr/bin/env python3
"""Check Lean sources against the mechanically-checkable rules in `LEAN_STYLE.md` and
`INSTRUCTIONS.md` §Comments.

    scripts/lean-style [FILE…]      check these files (default: everything tracked)
    scripts/lean-style --changed    check only files modified in the working tree
    scripts/lean-style --comments   run only the comment rules

Exit status is 1 when anything is reported, so it works as a Stop hook and as a manual linter.

Two rule tables, running in opposite directions. `RULES` fire on code with comments and string
literals blanked out (`strip_noncode`), so a rule cannot be tripped by prose quoting it.
`COMMENT_RULES` fire on the comment text alone, with the code blanked out (`code_only`) — the
comment discipline is about what a comment says, so it needs the dual.

Only rules with a zero-ambiguity textual form live here. "No deep `exact` nests", "aesop must be
terminal" and the tactic playbook are judgment calls — a regex for them produces false positives
(the first attempt flagged `exact Or.inl ((foo (B := B')).mp h)`, which is one lemma applied to one
projection and perfectly fine), and a checker that cries wolf gets switched off. The same goes for
proof narration, consumer notes and weak docstrings on the comment side. Those stay in
`LEAN_STYLE.md` and `INSTRUCTIONS.md` for a reader.

`SOFT_RULES` are reported as warnings and do not affect the exit status: real signal, but with
enough false positives that blocking on them would be wrong.

Vendored `Extra/Mathlib/**` is exempt: upstream code, upstream style.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
EXEMPT = ("Extra/Mathlib",)
# Tooling, not compiler source: `scripts/` names the paths it reads and writes, and those are
# `.claude/` paths. A comment there is documentation of an interface, not a plan reference.
COMMENT_EXEMPT = ("Extra/Mathlib", "scripts/")


def strip_noncode(lines: list[str]) -> list[str]:
    """Blank out comments and string literals so a rule cannot fire on prose.

    `LEAN_STYLE.md`'s own rules are quoted in docstrings all over this project; without this,
    the file documenting a rule is its own worst offender."""
    out, in_block = [], 0
    for line in lines:
        s = line
        if in_block:
            end = s.find("-/")
            if end == -1:
                out.append("")
                continue
            in_block -= 1
            s = " " * (end + 2) + s[end + 2:]
        # Block comments opening on this line.
        while True:
            start = s.find("/-")
            if start == -1:
                break
            end = s.find("-/", start + 2)
            if end == -1:
                s = s[:start]
                in_block += 1
                break
            s = s[:start] + " " * (end + 2 - start) + s[end + 2:]
        s = re.sub(r'--.*$', "", s)
        s = re.sub(r'"(?:[^"\\]|\\.)*"', '""', s)
        out.append(s)
    return out


def code_only(lines: list[str]) -> list[str]:
    """The dual of `strip_noncode`: keep comment text, blank everything else.

    A trailing `-- …` keeps its text; a `/- … -/` block keeps its interior. What is left is what a
    comment rule is allowed to see."""
    out, in_block = [], False
    for line in lines:
        s, kept = line, ""
        if in_block:
            end = s.find("-/")
            if end == -1:
                out.append(s)
                continue
            in_block = False
            kept, s = s[:end], s[end + 2:]
        while True:
            start = s.find("/-")
            if start == -1:
                break
            end = s.find("-/", start + 2)
            if end == -1:
                kept += " " + s[start + 2:]
                s = ""
                in_block = True
                break
            kept += " " + s[start + 2:end]
            s = s[end + 2:]
        m = re.search(r'--.*$', s)
        if m:
            # Keep the `--` itself: the commented-out-code and separator rules key on it.
            kept += (" " if kept else "") + (" " * (m.start() if not kept else 0)) + m.group(0)
        out.append(kept)
    return out


RULES = []
COMMENT_RULES = []
SOFT_RULES = []


def rule(name: str, fix: str):
    def deco(fn):
        RULES.append((name, fix, fn))
        return fn
    return deco


def comment_rule(name: str, fix: str):
    def deco(fn):
        COMMENT_RULES.append((name, fix, fn))
        return fn
    return deco


def soft_rule(name: str, fix: str):
    def deco(fn):
        SOFT_RULES.append((name, fix, fn))
        return fn
    return deco


@rule("exact absurd", "use the `absurd` tactic, or `nomatch h`")
def _absurd(code, raw):
    for i, l in enumerate(code):
        if re.search(r'\bexact\s+absurd\b', l):
            yield i, l.strip()


@rule("fun x => ", "write `λ x ↦` — `pp.unicode.fun` is on")
def _lambda(code, raw):
    for i, l in enumerate(code):
        if re.search(r'\bfun\b[^=]*=>', l):
            yield i, l.strip()


@rule("by_cases then push_neg", "use `by_cases! h : p` (same for `by_contra!`)")
def _bycases(code, raw):
    for i, l in enumerate(code):
        m = re.search(r'\bby_cases\s+(\w+)\s*:', l) or re.search(r'\bby_contra\s+(\w+)\b', l)
        if not m:
            continue
        h = m.group(1)
        for j in range(i + 1, min(i + 4, len(code))):
            if re.search(r'\bpush_neg\b.*\b' + re.escape(h) + r'\b', code[j]):
                yield i, l.strip()
                break


@rule("by / classical split", "put `by classical` on one line")
def _classical(code, raw):
    for i, l in enumerate(code[:-1]):
        if not l.rstrip().endswith(":= by"):
            continue
        for j in range(i + 1, len(code)):
            if code[j].strip():
                if code[j].strip() == "classical":
                    yield i, l.strip()
                break


@rule("rw [show … by …]", "state it as a `have` and rewrite with that")
def _rwshow(code, raw):
    for i, l in enumerate(code):
        if re.search(r'\b(rw|rwa|simp_rw|erw|erwa)\s*\[[^\]]*\bshow\b[^\]]*\bby\b', l):
            yield i, l.strip()


@rule("have … := <bare name>", "`change` it at the hypothesis, or inline the global at its use")
def _havebare(code, raw):
    ident = r"[A-Za-z_][A-Za-z0-9_'!?ₐ-ₜ₀-₉\.]*"
    for i, l in enumerate(code):
        m = re.search(r'\bhave\s+' + ident + r'\s*:\s*.*:=\s*(' + ident + r')\s*$', l)
        if m and m.group(1) not in ("by", "fun", "λ"):
            yield i, l.strip()


@rule("rename_i / expose_names", "`next x y => …`, or name it where it is bound")
def _renamei(code, raw):
    # A syntax quotation is the sanctioned use: `CustomPrelude`'s `split … using` and
    # `injections with` build `rename_i` into themselves so that no proof has to write it.
    for i, l in enumerate(code):
        if "`(" in l:
            continue
        if re.search(r'\b(rename_i|expose_names)\b', l):
            yield i, l.strip()


@rule("rw … at h then exact h", "`rwa [...] at h`")
def _rwaexact(code, raw):
    # Only the same-name `at` form is checked. `rw [...]` followed by a bare `exact foo` is the
    # same smell, but `foo` there may name a global lemma, which `rwa`'s `assumption` cannot find —
    # so that half stays a reader's rule in `LEAN_STYLE.md`.
    for i, l in enumerate(code[:-1]):
        m = re.search(r'\b(rw|erw|simp_rw)\s*\[[^\]]*\]\s*at\s+(\w+)\s*$', l)
        if not m:
            continue
        for j in range(i + 1, len(code)):
            if not code[j].strip():
                continue
            if re.fullmatch(r'\s*exact\s+' + re.escape(m.group(2)) + r'\s*', code[j]):
                yield i, l.strip()
            break


FOCUSING = ("|", "·", "case ", "next ", "all_goals", "any_goals", "end", "where", "<;>")


@rule("unbulleted subgoal", "bullet it — a `·` block must not be followed by a sibling goal at its own column")
def _unbulleted(code, raw):
    """A `·` block whose sibling branch is written unbulleted at the bullet's own column.

    Comments introducing the next branch are fine — they are already blank in `code`. A closing
    bracket is not a tactic, `case`/`next`/`|` are their own focusing syntax, and a combinator is
    explicit about applying to every goal."""
    for i, l in enumerate(code):
        s = l.lstrip()
        if not s.startswith("· "):
            continue
        ind = len(l) - len(s)
        j = i + 1
        while j < len(code) and (not code[j].strip() or len(code[j]) - len(code[j].lstrip()) > ind):
            j += 1
        if j >= len(code):
            continue
        nxt = code[j].lstrip()
        if len(code[j]) - len(nxt) == ind and not nxt.startswith(FOCUSING) and nxt[0] not in ")]}":
            yield j, raw[j].strip()


@rule("rw before simp/grind", "merge it in, or use `rewrite` — `rw`'s closing `rfl` is dead work here")
def _rwbeforesimp(code, raw):
    for i, l in enumerate(code[:-1]):
        if not re.match(r'^\s*rw\b', l):
            continue
        nxt = code[i + 1]
        if len(nxt) - len(nxt.lstrip()) != len(l) - len(l.lstrip()):
            continue
        if re.match(r'^\s*(simp|grind)\b', nxt):
            yield i, l.strip()


@rule("noConfusion", "use `contradiction` — `noConfusion` needs its implicits to line up")
def _noconfusion(code, raw):
    for i, l in enumerate(code):
        if re.search(r'\.noConfusion\b', l):
            yield i, l.strip()


# ---------------------------------------------------------------------------
# Comment rules. These fire on comment text only (`code_only`).

# Two shapes. A directive is a whole line on its own, so its keyword alone is decisive. A
# declaration keyword is also an ordinary English word ("instance", "class", "partial"), so it
# only counts when the rest of the line is shaped like a declaration.
DIRECTIVE_KW = r"import|open|set_option|#guard|@\[|deriving instance"
DECL_KW = (r"theorem|lemma|def|abbrev|instance|structure|inductive|class|partial|private"
           r"|protected|macro")


@comment_rule("commented-out code", "delete it — git has it")
def _commented_code(text, raw):
    for i, l in enumerate(text):
        if re.search(r'^\s*--\s*(' + DIRECTIVE_KW + r')\b', l):
            yield i, l.strip()
            continue
        # `by`/`where` only count at end of line: mid-sentence they are ordinary English.
        if (re.search(r'^\s*--\s*(' + DECL_KW + r')\b', l)
                and re.search(r'(:=|\bwhere\s*$|\bby\s*$)', l)):
            yield i, l.strip()
            continue
        # A run of three or more comment lines ending in `:=`/`by`/`⟩` is a pasted proof.
        if not re.match(r'^\s*--\s*\S', l) or i < 2:
            continue
        if not re.search(r'(:=|\bby\b|⟩)\s*$', l):
            continue
        if all(re.match(r'^\s*--\s*\S', text[j]) for j in (i - 1, i - 2)):
            yield i, l.strip()


@comment_rule("plan reference", "say the fact, not which document asks for it")
def _plan_ref(text, raw):
    for i, l in enumerate(text):
        if re.search(r'PLAN\.md|OPEN_QUESTIONS\.md|\.claude/', l):
            yield i, l.strip()


@comment_rule("section reference", "name the rule, not the section number — see reference/SPEC_MAP.md")
def _section_ref(text, raw):
    for i, l in enumerate(text):
        if re.search(r'§\s*[0-9]', l):
            yield i, l.strip()


@comment_rule("paper citation", "record it in reference/SPEC_MAP.md instead")
def _paper_ref(text, raw):
    pat = (r'arXiv|reference/\w+\.pdf|\[HFP|Specifying Systems'
           r'|(Definition|Remark|Listing|Example|Def\.)\s+[0-9]+\.[0-9]')
    for i, l in enumerate(text):
        if re.search(pat, l):
            yield i, l.strip()


@comment_rule("prior art", "state the current invariant, not what it replaced")
def _prior_art(text, raw):
    for i, l in enumerate(text):
        if re.search(r'prior art|distpcal-compiler|earlier design|once already', l, re.I):
            yield i, l.strip()


@comment_rule("line-numbered reference", "name the declaration — a line number rots silently")
def _line_ref(text, raw):
    for i, l in enumerate(text):
        if re.search(r'\.lean:[0-9]+', l):
            yield i, l.strip()


@comment_rule("bare separator", "delete it, or make it a `/-! … -/` section header")
def _bare_separator(text, raw):
    for i, l in enumerate(text):
        if re.fullmatch(r'\s*--+\s*', l):
            yield i, l.strip()


@comment_rule("subjectless TODO", "write `TODO(<subject>):` and say what is owed")
def _todo(text, raw):
    for i, l in enumerate(text):
        if re.search(r'TODO\b(?![(:])', l):
            yield i, l.strip()


@comment_rule("expiring URL", "delete it — the link is already dead")
def _expiring_url(text, raw):
    for i, l in enumerate(text):
        if re.search(r'githubusercontent\.com/.*jwt=', l):
            yield i, l.strip()


@soft_rule("long module doc", "a module doc over 25 lines is usually a design essay — PLAN.md owns that")
def _long_module_doc(text, raw):
    start, count = None, 0
    for i, l in enumerate(raw):
        if start is None:
            if re.match(r'^\s*/-!', l):
                start, count = i, 1
            continue
        count += 1
        if "-/" in l:
            if count > 25:
                yield start, raw[start].strip()
            start = None


@soft_rule("status prose", "a docstring should read as if the current state was always the state")
def _status_prose(text, raw):
    pat = r'still owed|not yet|for now|as it now stands|will produce|so far'
    for i, l in enumerate(text):
        if re.search(pat, l, re.I):
            yield i, l.strip()


def check(path: str, comments_only: bool = False) -> list[tuple[int, str, str, str]]:
    rel = os.path.relpath(os.path.abspath(path), ROOT)
    if any(e in rel for e in EXEMPT):
        return []
    raw = open(path, encoding="utf-8").read().splitlines()
    code = strip_noncode(raw)
    text = code_only(raw)
    found = []
    if not comments_only:
        for name, fix, fn in RULES:
            for i, _ in fn(code, raw):
                # Report the source line, not the comment/string-stripped one the rules matched on.
                found.append((i + 1, name, fix, raw[i].strip()))
    if not any(e in rel for e in COMMENT_EXEMPT):
        for name, fix, fn in COMMENT_RULES:
            for i, _ in fn(text, raw):
                found.append((i + 1, name, fix, raw[i].strip()))
    return sorted(found)


def check_soft(path: str) -> list[tuple[int, str, str, str]]:
    rel = os.path.relpath(os.path.abspath(path), ROOT)
    if any(e in rel for e in COMMENT_EXEMPT):
        return []
    raw = open(path, encoding="utf-8").read().splitlines()
    text = code_only(raw)
    found = []
    for name, fix, fn in SOFT_RULES:
        for i, _ in fn(text, raw):
            found.append((i + 1, name, fix, raw[i].strip()))
    return sorted(found)


def lean_files(args: list[str]) -> list[str]:
    args = [a for a in args if a != "--comments"]
    if args and args[0] == "--changed":
        out = subprocess.run(["git", "diff", "--name-only", "HEAD"], cwd=ROOT,
                             capture_output=True, text=True).stdout.split()
        out += subprocess.run(["git", "ls-files", "--others", "--exclude-standard"], cwd=ROOT,
                              capture_output=True, text=True).stdout.split()
        return [os.path.join(ROOT, f) for f in out
                if f.endswith(".lean") and os.path.exists(os.path.join(ROOT, f))]
    if args:
        return args
    out = subprocess.run(["git", "ls-files", "*.lean"], cwd=ROOT,
                         capture_output=True, text=True).stdout.split()
    return [os.path.join(ROOT, f) for f in out]


def main(argv: list[str]) -> int:
    comments_only = "--comments" in argv
    total, warned = 0, 0
    for path in lean_files(argv):
        rel = os.path.relpath(os.path.abspath(path), ROOT)
        for line, name, fix, text in check(path, comments_only):
            total += 1
            print(f"{rel}:{line}: {name} — {fix}")
            print(f"    {text[:110]}")
        for line, name, fix, text in check_soft(path):
            warned += 1
            print(f"{rel}:{line}: warning: {name} — {fix}")
    if total:
        print(f"\n{total} style violation(s). Rules: LEAN_STYLE.md, INSTRUCTIONS.md §Comments")
    if warned:
        print(f"{warned} warning(s), not blocking.")
    return 1 if total else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
